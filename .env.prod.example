# Modele pour un environnement SERVEUR (staging ou production).
# A copier en .env sur le VPS, dans le dossier de l'environnement,
# et a remplir avec de VRAIES valeurs. Jamais versionne.

# Domaine de l'environnement
#   production : rplace.ssylla.com
#   staging    : staging.rplace.ssylla.com
APP_DOMAIN=REMPLACER_PAR_LE_DOMAINE

# Image publiee par le pipeline sur GHCR
#   production : ghcr.io/seydousylla/r_place_clicker:production-latest
#   staging    : ghcr.io/seydousylla/r_place_clicker:staging-latest
APP_IMAGE=REMPLACER_PAR_L_IMAGE

# Port LOCAL du VPS sur lequel l'app est exposee (joint par k3s).
# Doit etre DIFFERENT pour chaque environnement sur le meme VPS.
#   staging    : 8090
#   production : 8091
APP_PORT=REMPLACER_PAR_LE_PORT

# Base de donnees (mot de passe long et aleatoire : openssl rand -hex 16)
POSTGRES_DB=rplace_db
POSTGRES_USER=rplace
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE