# Modèle pour un environnement SERVEUR (staging ou production).
# À copier en .env sur le VPS, dans le dossier de l'environnement,
# et à remplir avec de VRAIES valeurs. Jamais versionné.
# La présence de APP_IMAGE bascule le compose en mode "serveur" :
# l'image est téléchargée depuis GHCR au lieu d'être construite.
# Domaine de l'environnement
# production : rplace.ssylla.com
# staging    : staging.rplace.ssylla.com

APP_DOMAIN=REMPLACER_PAR_LE_DOMAINE

# Image publiée par le pipeline sur GHCR
#   production : ghcr.io/seydousylla/r_place_clicker:production-latest
#   staging    : ghcr.io/seydousylla/r_place_clicker:staging-latest
APP_IMAGE=REMPLACER_PAR_L_IMAGE

# Email pour les certificats Let's Encrypt
ACME_EMAIL=REMPLACER_PAR_TON_EMAIL

# Base de données (mot de passe long et aléatoire : openssl rand -hex 16)
POSTGRES_DB=rplace_db
POSTGRES_USER=rplace
POSTGRES_PASSWORD=REMPLACER_PAR_UN_MOT_DE_PASSE_ALEATOIRE

# En production, l'app n'est pas exposée directement (Traefik s'en charge).
# On fixe APP_PORT sur la boucle locale pour ne pas publier sur l'extérieur.
APP_PORT=127.0.0.1:8080
